{
  "name": "unified-ai-hub",
  "displayName": "Code Conductor",
  "description": "Code Conductor VS Code extension for Codex, Copilot, Antigravity, Ollama, and multi-agent coding workflows",
  "version": "0.1.0",
  "publisher": "local-developer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hakimnouira/code-conductor.git"
  },
  "keywords": [
    "ai",
    "copilot",
    "codex",
    "antigravity",
    "multi-agent",
    "orchestrator",
    "chatgpt"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:aiHub.chatView",
    "onCommand:aiHub.openChat",
    "onCommand:aiHub.checkHealth",
    "onCommand:aiHub.restartBackend",
    "onCommand:aiHub.explainSelection",
    "onCommand:aiHub.refactorSelection",
    "onCommand:aiHub.fixDiagnostics"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-coding-hub",
          "title": "AI Coding Hub",
          "icon": "media/robot.svg"
        }
      ]
    },
    "views": {
      "ai-coding-hub": [
        {
          "type": "webview",
          "id": "aiHub.chatView",
          "name": "AI Coding Hub Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "aiHub.openChat",
        "title": "AI Hub: Open Chat Panel"
      },
      {
        "command": "aiHub.checkHealth",
        "title": "AI Hub: Check Backend Health"
      },
      {
        "command": "aiHub.restartBackend",
        "title": "AI Hub: Restart Backend Server"
      },
      {
        "command": "aiHub.explainSelection",
        "title": "AI Hub: Explain Selection"
      },
      {
        "command": "aiHub.refactorSelection",
        "title": "AI Hub: Refactor Selection"
      },
      {
        "command": "aiHub.fixDiagnostics",
        "title": "AI Hub: Fix Current File Diagnostics"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aiHub.explainSelection",
          "when": "editorTextFocus",
          "group": "aiHub@1"
        },
        {
          "command": "aiHub.refactorSelection",
          "when": "editorTextFocus",
          "group": "aiHub@2"
        },
        {
          "command": "aiHub.fixDiagnostics",
          "when": "editorTextFocus",
          "group": "aiHub@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^7.0.2"
  }
}
