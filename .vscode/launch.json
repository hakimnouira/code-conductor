{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch AI Coding Hub Extension Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile (extension)"
    }
  ]
}
