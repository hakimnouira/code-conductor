# ==============================================================================
# CODE CONDUCTOR (Unified AI Coding Hub) - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in any keys or tokens you wish to use.
# All fields are optional: agents automatically detect available keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
# Optional: Set a fixed Bearer token for API & Web authentication.
# If left empty, Code Conductor automatically generates and persists a 64-char
# token in ~/.aihub_token upon startup.
AIHUB_AUTH_TOKEN=

# Host and Port for the FastAPI backend daemon
AIHUB_HOST=127.0.0.1
AIHUB_PORT=8765

# ------------------------------------------------------------------------------
# 2. GITHUB COPILOT
# ------------------------------------------------------------------------------
# Provide your GitHub token (Personal Access Token with Copilot access, or Copilot token).
# If left empty, Code Conductor automatically reuses your existing 'gh auth login'
# or active VS Code GitHub session without needing a separate token.
GITHUB_TOKEN=
# COPILOT_TOKEN=

# ------------------------------------------------------------------------------
# 3. OPENAI CODEX / CHATGPT SUBSCRIPTION
# ------------------------------------------------------------------------------
# Provide an OpenAI API Key if you want to use the OpenAI API directly.
# If left empty, Code Conductor automatically discovers and reuses your active
# ChatGPT Plus/Team subscription from ~/.codex (no API key required).
OPENAI_API_KEY=
# CODEX_API_KEY=

# ------------------------------------------------------------------------------
# 4. GOOGLE ANTIGRAVITY & GEMINI
# ------------------------------------------------------------------------------
# Google Gemini API key for cloud AI generation and Antigravity fallback layer.
# If left empty, Code Conductor connects directly to your running Antigravity IDE
# session via the local agentapi RPC daemon (~/.gemini/antigravity-ide/bin/agentapi.bat).
GEMINI_API_KEY=
# ANTIGRAVITY_API_KEY=

# ------------------------------------------------------------------------------
# 5. FAST CLOUD PROVIDERS & FREE TIERS
# ------------------------------------------------------------------------------
# Groq Cloud (Ultra-fast ~8ms inference: Qwen 3.8 27B / GPT-OSS 120B)
# You can provide a single key or multiple comma-separated keys for auto-rotation:
GROQ_API_KEY=
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# CodeCraft (Gemma 2 2B)
CODECRAFT_API_KEY=
# CODECRAFT_API_KEYS=cc_key1,cc_key2

# APMix Gateway (Claude Sonnet 4.6 Free / GPT-6 Luna Free)
APMIX_API_KEY=
# APMIX_API_KEYS=apx_live_key1,apx_live_key2

# Experiential Labs (AION 3.0 Mini)
EXPERIENTIALLABS_API_KEY=

# TokenHarbor (Claude Haiku 5.5 Free)
TOKENHARBOR_API_KEY=

# Firecrawl (Web Scraping & Markdown Extraction)
FIRECRAWL_API_KEY=

# ------------------------------------------------------------------------------
# 6. LOCAL OFFLINE MODELS
# ------------------------------------------------------------------------------
# Local Ollama runner URL (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
