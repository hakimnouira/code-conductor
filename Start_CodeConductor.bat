@echo off
title Code Conductor Launcher
echo ========================================================
echo       Starting Code Conductor AI Engineering Studio
echo ========================================================

set "PROJECT_DIR=%~dp0"
cd /d "%PROJECT_DIR%"

echo [*] Starting Backend server on http://127.0.0.1:8765...
rem The Python package lives in backend\app, not at the repository root.
set "PYTHONPATH=%PROJECT_DIR%backend"
start /b "" "%PROJECT_DIR%.venv\Scripts\python.exe" -m uvicorn app.main:app --host 127.0.0.1 --port 8765

timeout /t 2 /nobreak >nul

rem Read the token generated by the backend; never ship a shared bearer token in frontend source.
set "AIHUB_TOKEN="
for /L %%i in (1,1,10) do (
    if exist "%USERPROFILE%\.aihub_token" (
        set /p AIHUB_TOKEN=<"%USERPROFILE%\.aihub_token"
        if defined AIHUB_TOKEN goto :TokenReady
    )
    timeout /t 1 /nobreak >nul
)
:TokenReady
set "VITE_AI_HUB_TOKEN=%AIHUB_TOKEN%"

echo [*] Starting Web Interface on http://127.0.0.1:5173...
start /b "" cmd.exe /c "npm --prefix web run dev"

timeout /t 2 /nobreak >nul

set "CLOAK_EXE=%CODE_CONDUCTOR_CLOAK_EXE%"
if not defined CLOAK_EXE set "CLOAK_EXE=%USERPROFILE%\Downloads\cloakbrowser-windows-x64\chrome.exe"
if not exist "%CLOAK_EXE%" set "CLOAK_EXE=D:\Downloads\cloakbrowser-windows-x64\chrome.exe"
set "CLOAK_PROFILE=%PROJECT_DIR%.cloak_profile"

if exist "%CLOAK_EXE%" (
    echo [*] Opening in CloakBrowser with stealth session and port 9222...
    start "" "%CLOAK_EXE%" --remote-debugging-port=9222 --user-data-dir="%CLOAK_PROFILE%" --no-first-run --no-default-browser-check "http://127.0.0.1:5173"
) else (
    echo [*] Opening system browser...
    start http://127.0.0.1:5173
)

echo.
echo ========================================================
echo   Code Conductor is running!
echo   To STOP and turn off servers, run Stop_CodeConductor.bat
echo   or click the Turn Off button inside the app.
echo ========================================================
